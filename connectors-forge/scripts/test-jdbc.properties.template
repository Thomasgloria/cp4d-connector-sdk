# ============================================================
# JDBC Connector Test Configuration
# ============================================================
# Generated by Bob during connector creation.
# Copy this file to test-jdbc.properties, fill in your values,
# then tell Bob you are ready to run the tests.
#
# DO NOT commit test-jdbc.properties to source control —
# it contains real database credentials.
# ============================================================

# ── Flight Service (direct gRPC connection — no CP4D needed) ─────────────────
# Used by test-jdbc-flight.py to call the connector directly via Arrow Flight.
# FLIGHT_HOST: hostname only, no grpc+tls:// prefix
FLIGHT_HOST=<your-flight-hostname>
FLIGHT_PORT=443

# ── Connector Identity ───────────────────────────────────────
# Pre-filled by Bob from the DSL you created.
# Do not change DATASOURCE_TYPES unless you renamed the connector.

DATASOURCE_TYPES=<connector_name>

# ── Database Connection Properties ──────────────────────────
# Fill in your real database credentials.
# These are passed directly to the connector as connection properties.
# Use the JSON format shown below; do not change the key names.
#
# For JDBC connectors the standard keys are:
#   host, port, database, username, password
#
# Example (MySQL):
#   CONNECTION_PROPERTIES={"host":"db.example.com","port":"3306","database":"mydb","username":"alice","password":"s3cr3t"}
#
# Example (PostgreSQL):
#   CONNECTION_PROPERTIES={"host":"db.example.com","port":"5432","database":"mydb","username":"alice","password":"s3cr3t"}
CONNECTION_PROPERTIES={"host":"<db-host>","port":"<db-port>","database":"<db-name>","username":"<db-username>","password":"<db-password>"}
#
# For connectors that require an explicit JDBC URL (e.g. MarkLogic):
#   CONNECTION_PROPERTIES={"host":"<db-host>","port":"<db-port>","username":"<db-username>","password":"<db-password>","jdbc_url":"jdbc:marklogic://<db-host>:<db-port>"}
